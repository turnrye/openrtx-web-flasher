---
// SPDX-License-Identifier: GPL-3.0-or-later
// The radios the flasher knows, straight from its catalogue (src/radios.ts) and its
// backup record (src/coverage.ts): what this page shows is what the tool does.
import { gapsFor } from '../../src/coverage.ts';
import { apiFor, checksFor, RADIOS } from '../../src/radios.ts';

/** How the browser reaches a radio, in a few words. */
const CONNECTION = { usb: 'USB (WebUSB)', serial: 'Programming cable (Web Serial)', hid: 'USB (WebHID)' };

/** What the command line was checked for, as the table words it. */
const CHECKED = { flash: 'Flashing', backup: 'Backing up' };

const rows = RADIOS.map((radio) => {
  const api = apiFor(radio.method);
  const gaps = gapsFor(radio);
  const { commandLine } = checksFor(radio);
  return {
    radio,
    connection: api ? CONNECTION[api] : 'Copied as a file onto its USB drive',
    gaps,
    // One entry for each thing the command line was checked for on a real radio.
    commandLine: (['flash', 'backup'] as const).flatMap((purpose) =>
      commandLine[purpose] ? [`${CHECKED[purpose]}, ${commandLine[purpose].date}`] : [],
    ),
  };
});

/** The site's top, with a slash at the end: links here work from any page that shows the table. */
const top = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<table data-testid="radio-table">
  <thead>
    <tr>
      <th>Radio</th>
      <th>From the browser</th>
      <th>Flashing checked on a real radio</th>
      <th>Checked with the command line</th>
      <th>Backup before flashing</th>
      <th>Otherwise</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map(({ radio, connection, gaps, commandLine }) => (
        <tr>
          <td>
            <a href={`${top}#${radio.id}`}>{radio.name}</a>
            {radio.aka && <br />}
            {radio.aka && <small>{radio.aka}</small>}
          </td>
          <td>{connection}</td>
          <td>{radio.verified ? `Yes, ${radio.verified.date}` : 'Not yet'}</td>
          <td>{commandLine.join('; ') || 'Not yet'}</td>
          <td>
            {gaps.length === 0 ? (
              'Everything'
            ) : (
              <a href={`${top}backups/#${radio.id}`}>
                {gaps.length === 1 ? '1 critical gap' : `${gaps.length} critical gaps`}
              </a>
            )}
          </td>
          <td>
            <a href={radio.manual.url}>{radio.manual.tool}</a>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
