---
// SPDX-License-Identifier: GPL-3.0-or-later
// A row of figures in the style of the radio's display: the newest release, how many
// radios the flasher knows, and, when the build could ask GitHub, contributors, stars
// and the year it began. All counted at build time, none typed in.
import { community, latestRelease, radios, shortDate } from '../../home.ts';

const figures = [
  latestRelease && { value: latestRelease.label, label: `Latest release · ${shortDate(latestRelease.date)}` },
  { value: String(radios.length), label: 'Radios in the flasher' },
  community && { value: String(community.contributors.length), label: 'Contributors' },
  community && { value: String(community.stars), label: 'Stars on GitHub' },
  community?.created && { value: community.created.slice(0, 4), label: 'Built in the open since' },
].filter((f): f is { value: string; label: string } => Boolean(f));
---

<div class="not-content full-bleed [--band:#050506] border-y border-base-200" data-testid="home-stats">
  <dl class="grid grid-cols-[repeat(auto-fit,minmax(10rem,1fr))] gap-6 py-8">
    {
      figures.map((f) => (
        <div class="flex flex-col-reverse gap-1">
          <dt class="font-mono text-xs tracking-widest text-gray-400 uppercase">{f.label}</dt>
          <dd class="m-0 font-readout text-5xl leading-none text-primary">{f.value}</dd>
        </div>
      ))
    }
  </dl>
</div>
