---
// SPDX-License-Identifier: GPL-3.0-or-later
// Who makes OpenRTX: the four people the about page names as its creators and
// maintainers, everyone in GitHub's contributor list with their picture, and the
// newest office-hours notes.
import { community, posts, shortDate, top } from '../../home.ts';

/** As the about page lists them. */
const MAINTAINERS = [
  { name: 'Niccolò Izzo', call: 'IU2KIN' },
  { name: 'Silvano Seva', call: 'IU2KWO' },
  { name: 'Federico Amedeo Izzo', call: 'IU2NUO' },
  { name: 'Frederik Saraci', call: 'IU2NRO' },
];

const people = community?.contributors ?? [];
const officeHours = (await posts()).find((p) => /office hours/i.test(p.title));
---

<div class="not-content flex flex-col gap-6" data-testid="home-people">
  <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(13rem,1fr))] gap-4 p-0">
    {
      MAINTAINERS.map((m) => (
        <li class="card card-border border-base-200 bg-[#0c0d0f] p-5">
          <span class="font-readout text-4xl leading-none text-primary">{m.call}</span>
          <b class="mt-3 text-lg text-white">{m.name}</b>
          <span class="text-sm text-gray-400">Creator and maintainer</span>
        </li>
      ))
    }
  </ul>
  <div class="flex flex-wrap gap-4">
    {
      people.length > 0 && (
        <div class="card card-border min-w-0 flex-[2_1_30rem] gap-4 border-base-200 bg-[#0c0d0f] p-5" data-testid="home-contributors">
          <p class="font-mono text-xs tracking-widest text-gray-400 uppercase">
            {people.length} contributors on GitHub
          </p>
          <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
            {people.map((p) => (
              <li>
                <a href={p.url} title={p.login} class="block rounded-full">
                  {p.picture ? (
                    <img
                      src={`${top}community/${p.picture}`}
                      alt={p.login}
                      width="40"
                      height="40"
                      loading="lazy"
                      class="size-10 rounded-full bg-base-200 object-cover"
                    />
                  ) : (
                    <span class="flex size-10 items-center justify-center rounded-full bg-base-200 text-sm text-white">
                      {p.login.slice(0, 1).toUpperCase()}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      officeHours && (
        <a
          href={officeHours.href}
          class="card card-border min-w-0 flex-[1_1_18rem] gap-3 border-base-200 bg-[#0c0d0f] p-5 transition-colors hover:border-gray-400"
          data-testid="home-office-hours"
        >
          <span class="font-mono text-xs tracking-widest text-gray-400 uppercase">Office hours</span>
          <span class="font-readout text-4xl leading-none text-primary uppercase">{shortDate(officeHours.date.toISOString())}</span>
          <span class="text-base leading-relaxed text-gray-300">
            Open video calls anyone can join. Read what was discussed last time.
          </span>
        </a>
      )
    }
  </div>
</div>
