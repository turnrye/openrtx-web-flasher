---
// SPDX-License-Identifier: GPL-3.0-or-later
// The home page's hero, in place of Starlight's (only the home page has one). The words,
// buttons and photo come from the page's front matter, so they are edited there; this
// adds the line above the title and the radio's own screen next to the photo.
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';
import ScreenFrame from './ScreenFrame.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero ?? {};
const eyebrow = (data as { eyebrow?: string }).eyebrow;
const photo = image && 'file' in image ? image.file : undefined;
---

<div class="not-content" data-testid="home-hero">
  <div class="flex flex-wrap items-center gap-12 py-12 md:py-20">
    <div class="flex min-w-0 flex-[1_1_26rem] flex-col gap-6">
      {eyebrow && <p class="font-mono text-sm tracking-widest text-primary uppercase">{eyebrow}</p>}
      <h1
        id="_top"
        data-page-title
        class="text-5xl leading-[1.04] font-bold tracking-tight text-balance text-white md:text-6xl"
        set:html={title}
      />
      {tagline && <p class="max-w-xl text-lg leading-relaxed text-gray-300" set:html={tagline} />}
      {
        actions.length > 0 && (
          <div class="flex flex-wrap items-center gap-3">
            {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
              </LinkButton>
            ))}
          </div>
        )
      }
    </div>
    {
      photo && (
        <div class="relative min-w-0 flex-[1_1_26rem] pb-14">
          <div class="corner-ticks">
            <Image
              src={photo}
              alt={image?.alt ?? ''}
              widths={[480, 720, 1080]}
              sizes="(min-width: 72rem) 34rem, 100vw"
              loading="eager"
              fetchpriority="high"
              class="block h-80 w-full rounded object-cover md:h-[26rem]"
            />
          </div>
          <div class="absolute right-4 bottom-0 w-3/5 sm:right-6 sm:w-auto">
            <ScreenFrame kind="colour" scale={1.5} caption="OpenRTX's main screen" />
          </div>
        </div>
      )
    }
  </div>
</div>
