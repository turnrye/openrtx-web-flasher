{
  "name": "openrtx-web-flasher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "mirror": "node scripts/mirror-firmware.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:sh": "node scripts/shellcheck.mjs ci/*.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run lint:css && npm run lint:sh && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource/ubuntu": "^5.3.0",
    "fflate": "^0.8.3",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/w3c-web-hid": "^1.0.7",
    "@types/w3c-web-serial": "^1.0.9",
    "@types/w3c-web-usb": "^1.0.14",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
